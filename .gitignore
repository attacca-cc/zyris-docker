# Build output
/target
/dist

# Rust toolchain / editor local state
rust-toolchain.toml.local
.cargo/config.local.toml

# Credentials, tokens, keys — never leak the node identity
*.pem
*.key
*.token
*.p12
*.pfx
id_rsa*
id_ed25519*
*.cred
*.tombstone

# Node runtime state & enrollment data
.zyris/
.zyris-*
config.toml
credentials.toml
*credentials*
# Source is not a credential. **The comment on this line used to be on the one below it**, and
# git does not take a trailing `#` as a comment — only one at the start of a line — so the
# negation was the pattern `!src/**/credentials*   # (none, but don't ignore source)`, which
# matches nothing. `src/runtime/credentials.rs` was silently left out of a commit and CI caught
# it as `error[E0583]: file not found for module `credentials``.
!src/**/credentials*
*.part

# Environment / secrets
.env
.env.*
!.env.example

# Logs & runtime artifacts
*.log
*.pid
nohup.out

# Kube configs — never ship a cluster credential
kubeconfig
*.kubeconfig
admin.conf

# Editors and OS
.idea/
.vscode/
*.swp
*~
.DS_Store
Thumbs.db

# CI / scratch
/build/
/.release/
