# Copy to .env and fill in. These are read by the container at runtime.

# --- Attacca / zyris runtime ---
ZYRIS_SERVER_URL=wss://attacca.cc/api/zyris/v1/ws
ZYRIS_NODE_NAME=zyris-docker-node
ZYRIS_PROFILE=default
# Comma-separated scopes this node asks for at enrollment.
ZYRIS_SCOPES=agents:read,sessions:write,sessions:read,projects:read,jobs:write
# The node bearer token, or a file holding it. Prefer the *_FILE form in containers: an env var is
# visible in /proc and inherited by every process this node's `exec` capability spawns.
# With neither set the node enrolls itself and prints a code into the container log to approve.
ZYRIS_NODE_TOKEN=
ZYRIS_NODE_TOKEN_FILE=/run/secrets/zyris_token
# Where a self-enrolled credential is kept. Only used when neither variable above is set; the
# default is a declared volume, and it is outside ZYRISD_FILE_ROOTS on purpose.
# Commented out on purpose: this is the default, and `--env-file .env.example` would pin it.
#ZYRIS_CONFIG_DIR=/var/lib/zyris-docker

# --- self-healing watcher ---
ZYRISD_MONITOR_INTERVAL_SECS=30
# Comma-separated process comm names that must be running.
ZYRISD_WATCH_PROCESSES=nginx
# Comma-separated docker container names that must be running.
ZYRISD_WATCH_CONTAINERS=web,db
ZYRISD_WATCH_K8S=0
ZYRISD_HEAL_AGENT_ID=
ZYRISD_HEAL_PROJECT_ID=

# --- file_io / exec confinement ---
# Comma-separated roots Attacca may touch. Default (empty) is the whole container.
ZYRISD_FILE_ROOTS=/data
ZYRISD_EXEC_TIMEOUT_SECS=120
ZYRISD_MAX_OUTPUT_BYTES=262144
